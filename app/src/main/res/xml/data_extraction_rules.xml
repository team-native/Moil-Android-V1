<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 이상 백업·기기 이전 규칙.
   Keystore 키로 암호화한 인증 토큰과 현재 사용자 프로필은 다른 기기에서 복호화할 수 없으므로 제외한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="moil_auth_tokens.xml" />
        <exclude domain="sharedpref" path="moil_current_user_profile.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="moil_auth_tokens.xml" />
        <exclude domain="sharedpref" path="moil_current_user_profile.xml" />
    </device-transfer>
</data-extraction-rules>
